FROM php:8.5-fpm

ENV COMPOSER_ALLOW_SUPERUSER=1

# The extension installer is used rather than docker-php-ext-install, which
# builds each extension from source against whatever the base image currently
# ships and stopped being able to build opcache on php:8.5-fpm.
COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && install-php-extensions pcntl zip opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --no-autoloader --no-dev --prefer-dist

COPY . .

# --classmap-authoritative removes the filesystem lookup that the autoloader
# otherwise performs for every class it has not seen.
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

COPY database/database.sqlite /app/database/database.sqlite

COPY docker/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/zz-www.conf
COPY docker/entrypoint-prod.sh /usr/local/bin/entrypoint-prod
RUN chmod +x /usr/local/bin/entrypoint-prod

RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache /app/database

EXPOSE 9000

ENTRYPOINT ["entrypoint-prod"]
CMD ["php-fpm", "--nodaemonize"]
